{
  "$schema": "https://opencode.ai/config.json",

  "model": "opencode-go/glm-5.3-flash",
  "small_model": "opencode-go/mimo-v2.6-flash",
  "default_agent": "codeur",

  "permission": {
    "bash": {
      "*": "allow",

      "rm *": "deny",
      "rm -*": "deny",
      "rmdir*": "deny",
      "del *": "deny",
      "rd *": "deny",
      "Remove-Item*": "deny",
      "ri *": "deny",

      "git push*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git restore*": "deny",
      "git checkout -- *": "deny",
      "git checkout .": "deny",
      "git stash drop*": "deny",
      "git stash clear*": "deny",
      "git branch -D*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git remote*": "deny",
      "git config*": "deny",

      "npm install*": "deny",
      "npm i *": "deny",
      "npm uninstall*": "deny",
      "npx *": "deny",
      "curl *": "deny",
      "Invoke-WebRequest*": "deny",
      "iwr *": "deny"
    },

    "edit": "allow",
    "read": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "deny"
  }
}
