{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [
    "docs/CDC-MODE-MANAGEMENT.md",
    "docs/CDC-MODE-MANAGEMENT-ADDENDUM.md",
    "docs/CDC-ADDENDUM-2-LES-SIX-REGARDS.md",
    "docs/LES-SIX-VOIX-v1.1.md",
    "docs/CHARTE-INTERFACE-MANAGEMENT.md"
  ],

  "permission": {
    "bash": {
      "*": "ask",

      "npm test": "allow",
      "npm run lint": "allow",
      "npm run lint:content": "allow",
      "npm run check": "allow",
      "node tools/*": "allow",
      "node --test*": "allow",
      "npm ci": "allow",

      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git checkout -b*": "allow",

      "ls*": "allow",
      "cat*": "allow",
      "grep*": "allow",
      "rg*": "allow",

      "rm*": "deny",
      "git push*": "ask",
      "git reset*": "deny",
      "git clean*": "deny",
      "npm install*": "ask",
      "npx*": "ask"
    },

    "edit": "allow",
    "webfetch": "ask"
  }
}
